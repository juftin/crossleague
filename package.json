{
  "name": "crossleague",
  "version": "2.0.0",
  "description": "Universal power rankings and multi-league analytics dashboard for Sleeper and ESPN fantasy football leagues",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "build:check": "node scripts/build.js --check",
    "site": "node scripts/build.js && mkdir -p site && cp -r dist/* site/ && touch site/.nojekyll",
    "format": "prettier --write \"**/*.{js,json,html,css,md,yaml,yml,ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{js,json,html,css,md,yaml,yml,ts,tsx}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "test": "node --test tests/**/*.test.js",
    "snapshots": "node scripts/generate-snapshots.js",
    "snapshots:check": "node scripts/generate-snapshots.js --check",
    "dev": "vite --host 0.0.0.0"
  },
  "keywords": [
    "crossleague",
    "sleeper",
    "espn",
    "fantasy-football",
    "analytics",
    "power-rankings",
    "dashboard"
  ],
  "author": "Justin Flannery",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^15.14.0",
    "knip": "^6.37.0",
    "prettier": "^3.5.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  }
}
