{
  "name": "crossleague",
  "version": "2.0.0",
  "description": "Universal power rankings and multi-league analytics dashboard for Sleeper and ESPN fantasy football leagues",
  "main": "./src/js/index.js",
  "module": "./src/js/index.js",
  "exports": {
    ".": "./src/js/index.js",
    "./analytics": "./src/js/analytics/index.js",
    "./api": "./src/js/api/index.js",
    "./styles.css": "./src/css/styles.css",
    "./dist/app.min.js": "./dist/app.min.js",
    "./dist/styles.min.css": "./dist/styles.min.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "build:check": "node scripts/build.js --check",
    "docs": "node scripts/build.js && mkdir -p site && cp -r dist/* site/ && touch site/.nojekyll",
    "format": "prettier --write \"**/*.{js,json,html,css,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{js,json,html,css,md,yaml,yml}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/**/*.test.js",
    "snapshots": "node scripts/generate-snapshots.js",
    "snapshots:check": "node scripts/generate-snapshots.js --check",
    "dev": "vite --host 0.0.0.0"
  },
  "keywords": [
    "crossleague",
    "sleeper",
    "espn",
    "fantasy-football",
    "analytics",
    "power-rankings",
    "dashboard"
  ],
  "author": "Justin Flannery",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.20.0",
    "globals": "^15.14.0",
    "prettier": "^3.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  }
}
